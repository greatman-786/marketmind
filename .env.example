# Copy this file to `.env` and fill in your values.
# Never commit `.env` — it's gitignored.

# ---- Anthropic Claude API ----
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# ---- Database ----
# SQLite for local dev. For production, swap to a Postgres URL.
DATABASE_URL="file:./prisma/dev.db"

# ---- NextAuth (Auth.js) ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-32-byte-base64-string
AUTH_URL=http://localhost:3000

# ---- Google OAuth (optional, recommended for demo) ----
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Email magic links (optional) ----
# Get a free key at https://resend.com — 100 emails/day free
AUTH_RESEND_KEY=
EMAIL_FROM=onboarding@resend.dev
